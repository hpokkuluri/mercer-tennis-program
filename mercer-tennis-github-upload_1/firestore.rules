rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMember(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }
    function isAdmin(teamId) {
      return signedIn() &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Pending "invite by email" records — created by a team admin, consumed
    // (read + deleted) by the invitee's own client the moment they sign up.
    match /invites/{email} {
      allow read, delete: if signedIn();
      allow create: if isAdmin(request.resource.data.teamId);
    }

    match /teams/{teamId} {
      // Reading a team by code (to join) is allowed for any signed-in user;
      // once inside, only members can read/write team-scoped data below.
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isMember(teamId);

      match /members/{uid} {
        allow read: if isMember(teamId);
        allow create: if isAdmin(teamId) || (signedIn() && request.auth.uid == uid);
        allow update: if isAdmin(teamId) || (signedIn() && request.auth.uid == uid);
        allow delete: if isAdmin(teamId);
      }

      match /events/{eventId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId);
        allow update: if isMember(teamId);
        allow delete: if isAdmin(teamId);

        match /comments/{commentId} {
          allow read: if isMember(teamId);
          allow create: if isMember(teamId);
        }
      }

      match /announcements/{postId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId);
      }

      match /dms/{convoId} {
        allow read, write: if isMember(teamId) && request.auth.uid in resource.data.participants;
        allow create: if isMember(teamId) && request.auth.uid in request.resource.data.participants;

        match /messages/{msgId} {
          allow read: if isMember(teamId);
          allow create: if isMember(teamId) && request.auth.uid == request.resource.data.fromUid;
        }
      }
    }
  }
}
