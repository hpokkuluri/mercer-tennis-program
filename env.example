# Copy this file to ".env" and fill in values from your own free Firebase
# project (Project settings → General → Your apps → SDK setup and
# configuration). See SETUP.md for the full walkthrough.
#
# Until this file exists with real values, the app runs on a built-in
# local demo backend instead (no setup needed, but not shared across
# devices and not secure — see the banner on the login screen).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — real email notifications (invites + new event announcements),
# sent through your own Gmail account via a Netlify serverless function
# (see netlify/functions/send-email.js). This value just has to match the
# APP_SHARED_SECRET you set in Netlify's site environment variables — make
# up any random string. The Gmail credentials themselves live only in
# Netlify's env vars, never in this file or the client bundle.
VITE_APP_SHARED_SECRET=
